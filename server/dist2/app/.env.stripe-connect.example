# One HarborDirect platform account only
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# One Connect webhook for every boat owner's connected account
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me

# Separate webhook for HarborDirect setup fees and monthly subscriptions
