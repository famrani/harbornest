PUBLIC_APP_URL=http://localhost:8100
STRIPE_CONNECT_RETURN_URL=http://localhost:8100/alegria/admin/fleet?stripe=returned
STRIPE_CONNECT_REFRESH_URL=http://localhost:8100/alegria/admin/fleet?stripe=refresh

# Existing non-Stripe configuration remains unchanged.
