      "fb-1": { "ownerId": "owner-home-gintonics", "rating": 5, "title": "Our favorite night in the Riviera", "text": "The cocktails, the music and the sunset line-up were unreal. It felt like a private rooftop bar, just floating on the sea.", "author": "Chloe", "origin": "London" },
      "fb-2": { "ownerId": "owner-home-gintonics", "rating": 5, "title": "Team afterwork done right", "text": "Way better than any bar. We talked, laughed, had great drinks and everyone left relaxed and happy. The crew handled everything seamlessly.", "author": "Maxime", "origin": "Paris" },
      "fb-3": { "ownerId": "owner-home-gintonics", "rating": 5, "title": "Dreamy birthday cruise", "text": "They customised the playlist, brought out a little cake and even took pictures of all of us. It felt very personal and special.", "author": "Hannah", "origin": "Berlin" },
      "fb-4": { "ownerId": "owner-home-gintonics", "rating": 5, "title": "Chic but super relaxed", "text": "Stylish set-up, great sound system, but zero snobbery. Just kind people who love hosting and know the best spots for golden hour.", "author": "Romain", "origin": "Lille" },
      "fb-5": { "ownerId": "owner-home-gintonics", "rating": 5, "title": "Perfect pre-wedding celebration", "text": "We booked Gintonics the night before our wedding. Soft beats, gin & tonics, calm sea… It was exactly what we needed to unwind.", "author": "Isabella", "origin": "Milan" }
    },
    "owner-home-layali": {
      "fb-1": { "ownerId": "owner-home-layali", "rating": 5, "title": "Une parenthèse hors du temps", "text": "Tout était fluide : accueil, explications, navigation… On a eu l’impression d’être invités chez des amis, mais sur un catamaran !", "author": "Julie", "origin": "Lyon" },
