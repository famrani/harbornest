      "fb-3": { "ownerId": "owner-home-layali", "rating": 5, "title": "Coucher de soleil de rêve", "text": "Voir le soleil se coucher entre Antibes et les îles de Lérins avec un petit apéro à bord… On n’aurait pas pu rêver mieux pour notre anniversaire.", "author": "Nawal", "origin": "Nice" },
      "fb-4": { "ownerId": "owner-home-layali", "rating": 5, "title": "Organisation impeccable", "text": "Brief clair, bateau nickel, itinéraire ajusté à la météo. On sent qu’il y a du sérieux derrière le côté détendu. On recommande à 100 %.", "author": "Thomas", "origin": "Marseille" },
      "fb-5": { "ownerId": "owner-home-layali", "rating": 5, "title": "Comme à la maison, mais en mieux", "text": "Wi-Fi, musique, café, petites attentions pour tout le monde… On a oublié le temps qui passe. On reviendra pour tester la sortie matinée.", "author": "Elodie", "origin": "Toulouse" }
    },
    "owner-home-oriental-flavor": {
      "fb-1": { "ownerId": "owner-home-oriental-flavor", "rating": 5, "title": "Like stepping into another world", "text": "Lanterns, cushions, soft Arabic music… It felt like a summer night in Marrakech, but on the Riviera. So peaceful and beautiful.", "author": "Yasmine", "origin": "Geneva" },
      "fb-2": { "ownerId": "owner-home-oriental-flavor", "rating": 5, "title": "A very soulful experience", "text": "We didn’t feel like clients, more like guests. The tea ritual at sunset was a highlight — simple, warm and authentic.", "author": "Omar", "origin": "Brussels" },
      "fb-3": { "ownerId": "owner-home-oriental-flavor", "rating": 5, "title": "Romantic and intimate", "text": "The lighting and music created such an intimate atmosphere. We spent more time talking than taking photos, which says it all.", "author": "Claire", "origin": "Paris" },
      "fb-4": { "ownerId": "owner-home-oriental-flavor", "rating": 5, "title": "A beautiful mix of cultures", "text": "Oriental details, French Riviera views, and a crew who really cares. It resonated with our roots and felt incredibly familiar.", "author": "Amine", "origin": "Casablanca" },
      "fb-5": { "ownerId": "owner-home-oriental-flavor", "rating": 5, "title": "Slow, calm and mindful", "text": "No rush, no loud party vibes. Just time to breathe, sip mint tea and watch the colours of the sky change over the sea.", "author": "Sophie", "origin": "Lyon" }
